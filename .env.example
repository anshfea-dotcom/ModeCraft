# AERLON server-side configuration: placeholders only; never put real credentials here.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
AFFILIATE_SIGNING_SECRET=

# Razorpay: Key ID may be shared with checkout; secrets must remain server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password reset and transactional email: choose Resend or SMTP.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional internal services and canonical store origin.
CATALOGUE_SERVICE_URL=
MEDIA_SERVICE_URL=
STOREFRONT_URL=
